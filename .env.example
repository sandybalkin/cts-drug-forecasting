# Embedded DuckDB file for the local PharmaLaunch database.
# Relative paths are resolved from the repository root.
# No database server or password is required.
DUCKDB_PATH=data/pharmalaunch.duckdb

# Forecast inputs are local. Rscript fits historical Bass p and q.
# FORECAST_DATA_SOURCE=local
# RSCRIPT_PATH=Rscript

# Optional directory for the prepared similarity/Bass/weekly tables.
# FORECAST_CACHE_DIR=data/.forecast_cache

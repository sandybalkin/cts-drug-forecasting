# Embedded DuckDB file for the local PharmaLaunch database.
# Relative paths are resolved from the repository root.
# No database server or password is required.
DUCKDB_PATH=data/pharmalaunch.duckdb

# Optional. The forecasting engine reads Databricks gold tables when these
# are set. They are not the local application database.
# DATABRICKS_SERVER_HOSTNAME=
# DATABRICKS_HTTP_PATH=
# DATABRICKS_TOKEN=
